digraph C4App {
  // Та же сетка, что у схемы бэкенда: remincross=false держит порядок
  // блоков, splines=ortho — прямые линии, подписи — узлы в разрыве линии.
  // Под редьюсерами в их кластере ничего не стоит: длинное ребро к порту
  // не проходит сквозь ряд блоков того же кластера, dot обводит его
  // справа от рамки, и все нижние слои уезжают вбок. Чистые функции
  // поэтому стоят в одной строке с редьюсерами.
  graph [rankdir=TB, newrank=true, remincross=false, splines=ortho,
         nodesep=0.25, ranksep=0.3, pad=0.08,
         fontname="Helvetica", fontsize=11, labeljust=c];
  node  [shape=box, style="filled", fillcolor="white", color="#333333", penwidth=1.2,
         fontname="Helvetica", fontsize=11, margin="0.10,0.05"];
  edge  [arrowsize=0.7, color="#333333"];

  // Номера — шаги экранной спеки AWP (экран снимка); у диалога карточки
  // те же шаги WCL. Запрос на сервер — шаг WFP Ш6 у снимка, WCL Ш1 у
  // карточки. Слои типов: экран и виджеты — UI-типы; порты говорят
  // доменом; app — зеркала в домен; шлюзы — транспорт в зеркала.

  subgraph cluster_L1 {
    label="Экран (Compose)"; style="filled"; fillcolor="#FDF4FF"; color="#E879F9";
    UI0 [label="Вкладка «Слова»\n[экран, screen/wordstab]\nдиалог скана: «Камера»,\n«Галерея»; переход на экран",
         style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    UI1 [label="Экран лексем-кандидатов\n[экран, screen/scancandidates]\nфазы, окно с карточками,\nназад с результатом",
         fillcolor="#fff1b8", color="#b58900", penwidth=2];
    UI2 [label="Диалог лексем-кандидатов\n[диалог, screen/wordcard]\nразделы лемм,\nте же виджеты",
         style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    UI3 [label="Виджеты\n[widget/candidates]\nкарточки, листы,\n«Замечания», «Сопоставление»",
         style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    { rank=same; UI0 -> UI1 -> UI2 -> UI3 [style=invis, weight=100]; }
  }

  RESP [style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0", margin="0.12,0.06",
        label=<<table border="0" cellpadding="0" cellspacing="2">
          <tr><td align="left">Что видит пользователь</td></tr>
          <tr><td align="left">[спеки AWP, WCL]</td></tr>
          <tr><td align="left">Ш2 значения по компонентам</td></tr>
          <tr><td align="left">— меняется; «англ.» — новое</td></tr>
          <tr><td align="left">В1 «Не удалось собрать окно»</td></tr>
          <tr><td align="left">отказ → причина;</td></tr>
          <tr><td align="left">сеть, 503 → «Повторить»</td></tr>
          <tr><td align="left">В2 «Закрыть без добавления?»</td></tr>
          <tr><td align="left">В3 «Не добавилось», «Повторить»</td></tr>
          <tr><td align="left">Ш5 «Добавлено N значений</td></tr>
          <tr><td align="left">в M слов»</td></tr>
        </table>>];

  subgraph cluster_L2 {
    label="Логика (редьюсеры и чистые функции widget/candidates)"; style="filled"; fillcolor="#F0FDFA"; color="#2DD4BF";
    R0 [label="WordsTabReducer\n[редьюсер]\nдиалог скана, эффект запуска\nкамеры, переход на экран",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    R1 [label="ScanCandidatesReducer + атомы\n[редьюсер]\nMsg → цепочка атомов,\nбез номера запуска",
        fillcolor="#fff1b8", color="#b58900", penwidth=2];
    R2 [label="WordCardReducer + CandidatesAtoms\n[редьюсер]\nто же над CandidatesState,\nномер запуска остаётся",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    F1 [label="Чистые функции\n[widget/candidates]\nкарточки, пометки, пакет, toUi;\nновое: «Замечания», «Сопоставление»",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    { rank=same; R0 -> R1 -> R2 -> F1 [style=invis, weight=100]; }
    R1 -> F1;
    R2 -> F1;
  }

  subgraph cluster_L3 {
    label="Порты (интерфейсы юзкейсов, говорят доменом)"; style="filled"; fillcolor="#FFF7ED"; color="#FB923C";
    U0 [label="WordsTabUseCase\n[порт]\nсловарь, список слов;\nснимок ушёл",
        style="rounded,filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    U1 [label="ScanCandidatesUseCase\n[порт]\nраспознать, запрос с деревом,\nформа, пакет",
        style="rounded,filled", fillcolor="#fff1b8", color="#b58900", penwidth=2];
    U2 [label="WordCardUseCase\n[порт]\nзапрос по слову, форма, пакет",
        style="rounded,filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    { rank=same; U0 -> U1 -> U2 [style=invis]; }
  }

  subgraph cluster_L4 {
    label="Реализация юзкейсов и навигация (app)"; style="filled"; fillcolor="#ECFEFF"; color="#22D3EE";
    A1 [label="ScanCandidatesUseCaseImpl,\nWordCardUseCaseImpl\n[адаптер]\nснимок, сеть, база",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    A2 [label="ComponentTreeLoader\n[сборщик]\nкомпоненты, опции,\nзависимости → дерево",
        fillcolor="#fff1b8", color="#b58900", penwidth=2];
    A3 [label="app/mapper\n[мапперы]\nзеркала → домен, toDomain:\nответ, форма",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    A4 [label="AppNavTable\n[навигация]\nOpenScanCandidates(uri),\nназад с результатом",
        fillcolor="#fff1b8", color="#b58900", penwidth=2];

    node [shape=box, style="filled", fillcolor="#e8e8e8", color="#e8e8e8", penwidth=0,
          fontsize=10, margin="0.04,0.02", width=0, height=0];
    e7 [label="дерево"];
    e8 [label="зеркала"];

    { rank=same; A1 -> A2 -> A3 -> A4 [style=invis, weight=100]; }
    { rank=same; e7 -> e8 [style=invis]; }
  }

  subgraph cluster_L5 {
    label="Шлюзы (core): транспорт → зеркала *ApiEntity"; style="filled"; fillcolor="#F5F3FF"; color="#A78BFA";
    G1 [label="WordsApi\n[core-network]\nRetrofit *Net, коды ответа,\nLookupResult",
        style="filled,dashed", fillcolor="#e8f4ff", color="#2b6cb0"];
    G2 [label="CoreDbApi\n[core-db, Room *Db]\nкомпоненты, опции, леммы,\nгруппы, пакет одной транзакцией",
        shape=cylinder, fillcolor="#f3f3f3", color="#888888"];
    G3 [label="ML Kit\n[library/textrecognition]\nтекст со снимка",
        fillcolor="#f3f3f3", color="#888888"];
    { rank=same; G1 -> G2 -> G3 [style=invis]; }
  }

  subgraph cluster_L6 {
    label="Снаружи"; style="filled"; fillcolor="#F0FDF4"; color="#4ADE80";
    X1 [label="Бэкенд\n[внешняя система]\nPOST /v1/words/lookup", fillcolor="#f3f3f3", color="#888888"];
  }

  node [shape=box, style="filled", fillcolor="#e8e8e8", color="#e8e8e8", penwidth=0,
        fontsize=10, margin="0.04,0.02", width=0, height=0];
  e1 [label="действия диалога скана"];
  e2 [label=<<b>Ш3–4</b> действия окна>];
  e3 [label=<<b>Ш3–4</b> действия диалога>];
  e4 [label="навигация"];
  e5 [label=<<b>WFP Ш4–6</b> снимок, запрос<br/><b>Ш1</b> форма, <b>Ш4</b> пакет>];
  e6 [label=<<b>WCL Ш1</b> запрос<br/>форма, пакет>];
  r1 [label="реализован в"];
  r2 [label="реализован в"];
  e10 [label="сеть"];
  e11 [label="компоненты, опции"];
  e13 [label="пакет, форма"];
  e14 [label="снимок"];
  rx [label="HTTPS"];
  { rank=same; e1 -> e2 -> e3 [style=invis]; }
  { rank=same; e4 -> e5 -> e6 [style=invis]; }
  { rank=same; r1 -> r2 [style=invis]; }
  { rank=same; e10 -> e11 -> e13 -> e14 [style=invis]; }

  // Сноска «что видит пользователь» — внизу справа, где пусто.
  { rank=same; X1; RESP; }

  UI0 -> e1 [arrowhead=none]; e1 -> R0;
  UI1 -> e2 [arrowhead=none]; e2 -> R1;
  UI2 -> e3 [arrowhead=none]; e3 -> R2;
  // Эффекты редьюсера исполняет handler: он зовёт юзкейс; навигацию —
  // AppNavTable в app.
  R0 -> e4 [arrowhead=none, minlen=2]; e4 -> A4;
  R1 -> e5 [arrowhead=none]; e5 -> U1;
  R2 -> e6 [arrowhead=none]; e6 -> U2;
  U1 -> r1 [arrowhead=none]; r1 -> A1;
  U2 -> r2 [arrowhead=none]; r2 -> A1;
  A1 -> e7 [arrowhead=none]; e7 -> A2;
  A1 -> e8 [arrowhead=none]; e8 -> A3;
  A1 -> e10 [arrowhead=none, minlen=3]; e10 -> G1;
  A2 -> e11 [arrowhead=none]; e11 -> G2;
  A1 -> e13 [arrowhead=none, minlen=3]; e13 -> G2;
  A1 -> e14 [arrowhead=none, minlen=3]; e14 -> G3;
  G1 -> rx [arrowhead=none]; rx -> X1;
}
